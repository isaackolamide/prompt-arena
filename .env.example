# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key

# App Configuration
ENV=development
PORT=8000

# AWS Lambda Configuration
AWS_ACCESS_KEY_ID=mock-aws-access-key-id
AWS_SECRET_ACCESS_KEY=mock-aws-secret-access-key
AWS_REGION=us-east-1
AWS_LAMBDA_FUNCTION_NAME=prompt-arena-sandbox
# Optional local endpoint for LocalStack or local testing
AWS_LAMBDA_ENDPOINT_URL=
